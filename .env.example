PORT=3000
NODE_ENV=development

# URL del frontend (para CORS)
CORS_ORIGIN=http://localhost:5173

# Conexión a PostgreSQL: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/juegoslink

# Clave para firmar los JWT: un texto largo y aleatorio, distinto en cada entorno
JWT_SECRET=
# Duración de la sesión (ej: 1h, 7d)
JWT_EXPIRES_IN=7d

# Key de la API de juegos RAWG (https://rawg.io/apidocs). Nunca la subas al repo.
RAWG_API_KEY=
