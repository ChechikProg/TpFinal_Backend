PORT=3000
NODE_ENV=development

# URL del frontend (para CORS)
CORS_ORIGIN=http://localhost:5173

# Conexión a PostgreSQL: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/juegoslink

# Se completan cuando hagamos el login
JWT_SECRET=
JWT_EXPIRES_IN=7d
